<html lang='en'>
  <meta charset='utf-8' />
  <title>Wisp dependency licenses</title>
  <h1>Rust dependency licenses</h1>
  {{#each licenses}}
    <h2>{{name}}</h2>
    <ul>
      {{#each used_by}}<li>{{crate.name}} {{crate.version}}</li>{{/each}}
    </ul>
    <pre>{{text}}</pre>
  {{/each}}
</html>